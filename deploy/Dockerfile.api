# The API (also carries the operator CLIs: migrations, tenant-zero, provision). Build context: the repository root.
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile \
 && pnpm --filter @erp/db --filter @erp/meta --filter @erp/api build \
 && pnpm --filter @erp/api deploy --legacy --prod /out/api

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out/api /app
COPY db/migrations /app/db/migrations
ENV ERP_MIGRATIONS_DIR=/app/db/migrations
USER node
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=5 CMD node -e "fetch('http://127.0.0.1:3001/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
