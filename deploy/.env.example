# Copy to deploy/.env ON THE SERVER (never commit the real one). Generate each secret yourself, e.g. `openssl rand -base64 32`.
POSTGRES_SUPERUSER_PASSWORD=
ERP_APP_PASSWORD=
ERP_SCHEDULER_PASSWORD=
# 32 random bytes, base64: encrypts TOTP secrets. Losing it locks every TOTP user out, so keep a copy somewhere safe.
TOTP_ENCRYPTION_KEY=

# Your site name, once you own one (Caddy fetches the certificate). Empty serves plain HTTP on :80 for a first look.
DOMAIN=

# Backups, encrypted with age before they leave the server. BACKUP_AGE_RECIPIENT is a PUBLIC key (age1...); keep the private key
# offline. With these empty nothing is shipped (the backup service says so in its log).
BACKUP_AGE_RECIPIENT=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_BASE_HOUR_UTC=20

# Optional: send traces to an OTLP/HTTP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
