# Copy to .env (git-ignored). Dev-only values: never reuse these anywhere real.
NODE_ENV=development
PORT=3001

# The dev-db container's superuser, and the superuser URL used ONLY by `pnpm db:setup`
# (migrations; 0001 needs a real superuser). The API never sees it.
POSTGRES_SUPERUSER_PASSWORD=dev-only-superuser-password
DEV_DB_PORT=5432
DATABASE_ADMIN_URL=postgres://postgres:dev-only-superuser-password@127.0.0.1:5432/erp_dev

# erp_app: the API's only role. `pnpm db:set-app-password` sets its password from ERP_APP_PASSWORD
# (at least 12 characters), and DATABASE_URL must use the same one.
ERP_APP_PASSWORD=dev-only-app-password
DATABASE_URL=postgres://erp_app:dev-only-app-password@127.0.0.1:5432/erp_dev

# Development only: take tenant and user from x-dev-tenant-id / x-dev-user-id headers.
# The API refuses to start with this on when NODE_ENV=production. Replaced by sessions in M2.
DEV_AUTH_STUB=true
